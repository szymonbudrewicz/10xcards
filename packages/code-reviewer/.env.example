# Copy to .env (gitignored). Use a separate OpenRouter key with a spending limit.
OPENROUTER_API_KEY=
# Optional: any OpenRouter model id (default: openai/gpt-6-luna, chosen by npm run eval)
# REVIEW_MODEL=anthropic/claude-haiku-5.5

# Per-run limits; exceeding one prints [limit] on stderr and exits with code 2.
# Max billed cost of one run in USD (default: 0.10)
# REVIEW_MAX_COST_USD=0.10
# Diffs longer than this many characters are rejected before calling the model (default: 200000)
# REVIEW_MAX_DIFF_CHARS=200000
# Max tokens the model may generate per call, reasoning included (default: 16000)
# REVIEW_MAX_OUTPUT_TOKENS=16000
# Max reasoning tokens (OpenRouter reasoning.max_tokens), must be below the output limit;
# 0 = no separate cap, only REVIEW_MAX_OUTPUT_TOKENS applies (default: 8000)
# REVIEW_MAX_REASONING_TOKENS=8000
